      {
        "block_id": "RyhWdaS46oxpjTxXCrxcF5eSnqb",
        "block_type": 2,
        "parent_id": "HexPdpU4uowtfZx1IIscgIKrnce",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "五板上常出现二选一的情况，第一，看五板当日真实换手率，要适中，<= 15% 和 >= 80%的都不好；第二，尽量排除平低开的票（集合竞价后 -3.5% - 1% 开盘的票）；第三，可以偏向有梯队效应的票",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "Q5Gsd1tCIo64hZxgBO7ce5SYnbu",
        "block_type": 2,
        "parent_id": "HexPdpU4uowtfZx1IIscgIKrnce",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "卖出点在卡异动当日",
                "text_element_style": {
                  "bold": true,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": true
                }
              }
            },
            {
              "text_run": {
                "content": "，中途出现其他五板标的不能提前卖",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
