        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "如果没有上涨，在第四天（Day9）收盘全部卖出",
                "text_element_style": {
                  "background_color": 3,
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
