{
  "strategy_name": "strict23_mainline_dragon",
  "description": "极严防过拟合二进三：主线题材龙头(rk_theme=1) + 宏观晋级良性(promo>=20%) + 高锁仓(lock>=50%) + 高封板紧密度(seal>=40)",
  "rules": [
    {
      "name": "Base Pool",
      "condition": "换手二板非一字 + 开盘可买 + 集合竞价高开3%~8%",
      "mechanism": "锁定黄金开盘溢价，排除一字开板核按钮与平开弱势分歧"
    },
    {
      "name": "Rule 1: 主线题材龙头",
      "condition": "rk_theme == 1",
      "mechanism": "全市场第1最强主线题材龙头，享有最高流动性溢价与合力支持，杜绝非主线杂毛分歧大面"
    },
    {
      "name": "Rule 2: 宏观自然晋级良性",
      "condition": "mkt_promo_1to2_5d >= 0.20",
      "mechanism": "全市场近5日1进2晋级率>=20%，代表接力赚钱效应良性扩散，有效规避退潮期与冰点期"
    },
    {
      "name": "Rule 3: 前十大股东高锁仓",
      "condition": "lock_top10 >= 50.0%",
      "mechanism": "前十大股东持股锁仓比例高，实际外部自由流通盘小，接力资金拉升阻力显著降低"
    },
    {
      "name": "Rule 4: 二板封板坚决度极高",
      "condition": "seal_tightness >= 40.0",
      "mechanism": "前一日二板盘口紧密、封单坚决，主力做多决心坚定，剔除尾盘偷袭与烂板"
    }
  ],
