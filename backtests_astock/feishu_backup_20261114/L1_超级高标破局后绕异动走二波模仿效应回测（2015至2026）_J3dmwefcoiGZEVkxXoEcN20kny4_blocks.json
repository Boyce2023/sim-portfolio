        "text": {
          "elements": [
            {
              "text_run": {
                "content": "超级破局龙走出的卡异动二波无法批量复制，跟风模仿者的横盘企图大多沦为击鼓传花的大面温床。",
                "text_element_style": {
                  "background_color": 3,
                  "bold": true,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
