        "heading2": {
          "elements": [
            {
              "text_run": {
                "content": "一、核心总结论与第一性原理",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
